# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ EAP Test Suite - .gitignore                                               ║
# ╠═══════════════════════════════════════════════════════════════════════════╣
# ║ RADIUS/EAP testing tool for network authentication validation            ║
# ║ Stack: Python 3.x, pytest, RADIUS client libraries                       ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ─── Python Core ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# ─── Virtual Environments ────────────────────────────────────────────────────
# All standard Python virtual environment directories
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.Python

# ─── Distribution & Packaging ────────────────────────────────────────────────
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Testing & Coverage ──────────────────────────────────────────────────────
# pytest artifacts
.pytest_cache/
.cache
nosetests.xml

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
cover/

# Test framework directories
.tox/
.nox/
.hypothesis/

# ─── Type Checking & Linting ─────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/
.ruff_cache/

# ─── Documentation ───────────────────────────────────────────────────────────
docs/_build/
/site

# ─── Logs & Runtime Data ─────────────────────────────────────────────────────
*.log
*.sqlite3
*.sqlite
*.db

# ─── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.*
.env.local
*.pem
*.key

# ─── Project-Specific Artifacts ──────────────────────────────────────────────
# hostapd source/build directory (used for EAP testing)
hostap/

# Test execution logs and results
logs/

# Archive directory for old test results
archive/

# PyInstaller artifacts (if building executables)
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt
